# Offline/LAN deployment example.
# Copy this file to .env and change passwords before real use.

TZ=Asia/Bangkok
APP_ENV=production
APP_EDITION=lan_server
DATABASE_ENGINE=postgres

POSTGRES_DB=seamlessfordmis
POSTGRES_USER=seamlessfordmis
POSTGRES_PASSWORD=CHANGE_ME_OFFLINE_DB_PASSWORD
DATABASE_URL=postgresql+psycopg://seamlessfordmis:CHANGE_ME_OFFLINE_DB_PASSWORD@db:5432/seamlessfordmis

CORS_ORIGINS=http://localhost,http://127.0.0.1
# Empty means same-origin; frontend request paths already start with /api.
NEXT_PUBLIC_API_BASE_URL=
HTTP_PORT=80

DATA_DIR=/app/data
SOURCE_DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads/target_groups
PARSED_CACHE_DIR=/app/uploads/parsed_cache
REPORTS_DIR=/app/reports
EXPORTS_DIR=/app/reports/exports
LOGS_DIR=/app/logs
LOG_DIR=/app/logs
BACKUP_DIR=/backups
