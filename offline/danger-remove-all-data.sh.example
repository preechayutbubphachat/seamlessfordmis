#!/usr/bin/env sh
# ============================================================
#  danger-remove-all-data.sh.example  (Linux/macOS)
#
#  [อันตรายมาก] ลบข้อมูลผู้ป่วยและฐานข้อมูลทั้งหมดออกอย่างถาวร
#
#  นี่คือไฟล์ตัวอย่าง (.example) — ต้องเปลี่ยนชื่อเป็น
#  danger-remove-all-data.sh ก่อนจึงจะรันได้:
#    mv offline/danger-remove-all-data.sh.example offline/danger-remove-all-data.sh
#    chmod +x offline/danger-remove-all-data.sh
#
#  ใช้เฉพาะเมื่อ:
#    - ต้องการล้างระบบเพื่อทดสอบใหม่ทั้งหมด
#    - ต้องการถอนการติดตั้งระบบและลบข้อมูลออกทุกอย่าง
#    - ได้รับอนุญาตจากผู้บริหารโรงพยาบาลอย่างเป็นลายลักษณ์อักษร
#
#  สิ่งที่จะถูกลบถาวร (ไม่สามารถกู้คืนได้):
#    x ฐานข้อมูลผู้ป่วย (postgres_data)
#    x ข้อมูลต้นทาง (source_data)
#    x ไฟล์ที่อัปโหลด (uploads)
#    x รายงาน (reports)
#    x Logs ใน Docker volume (logs)
#    x ข้อมูลสำรองใน data/backups/
#
#  สิ่งที่จะ ไม่ ถูกลบ:
#    + ไฟล์โปรแกรม (offline/, docker/, docker-compose.yml)
#    + ไฟล์ .env (การตั้งค่า)
#    + Logs ใน /var/log/ หรือ logs/ ของ host
#
#  กรุณาสำรองข้อมูลก่อนรันสคริปต์นี้เสมอ!
# ============================================================
set -eu
cd "$(dirname "$0")/.."

# ตรวจสอบ Docker
if ! command -v docker >/dev/null 2>&1; then
  echo "[ERROR] ไม่พบ Docker กรุณาเปิด Docker Engine ก่อน"
  exit 1
fi
if ! docker info >/dev/null 2>&1; then
  echo "[ERROR] Docker ยังไม่ทำงาน กรุณาเริ่ม Docker daemon แล้วรอจนพร้อม"
  exit 1
fi

echo ""
echo " ╔══════════════════════════════════════════════════════════╗"
echo " ║  [อันตราย] ลบข้อมูลผู้ป่วยทั้งหมดออกอย่างถาวร         ║"
echo " ╠══════════════════════════════════════════════════════════╣"
echo " ║  ข้อมูลที่จะถูกลบ ไม่สามารถกู้คืนได้                  ║"
echo " ║  ตรวจสอบให้แน่ใจว่าสำรองข้อมูลแล้ว                    ║"
echo " ╚══════════════════════════════════════════════════════════╝"
echo ""
echo "  Docker volumes ที่จะถูกลบถาวร:"
echo "    • seamlessfordmis_postgres_data   (ฐานข้อมูลผู้ป่วย)"
echo "    • seamlessfordmis_source_data     (ข้อมูลต้นทาง)"
echo "    • seamlessfordmis_uploads         (ไฟล์อัปโหลด)"
echo "    • seamlessfordmis_reports         (รายงาน)"
echo "    • seamlessfordmis_logs            (Logs)"
echo ""
echo "  โฟลเดอร์ที่จะถูกลบถาวร:"
echo "    • data/backups/                   (ข้อมูลสำรอง)"
echo ""

# ---- ขั้นตอนที่ 1: ยืนยันครั้งที่ 1 ----
echo " ════════════════════════════════════════"
echo "  ขั้นตอนการยืนยัน 1/3"
echo " ════════════════════════════════════════"
echo ""
printf "  พิมพ์ YES เพื่อยืนยันว่าต้องการลบข้อมูลทั้งหมด: "
read -r CONFIRM1
if [ "$CONFIRM1" != "YES" ]; then
  echo ""
  echo "  ยกเลิกการดำเนินการ ไม่มีข้อมูลถูกลบ"
  echo ""
  exit 0
fi

# ---- ขั้นตอนที่ 2: พิมพ์ข้อความยืนยัน ----
echo ""
echo " ════════════════════════════════════════"
echo "  ขั้นตอนการยืนยัน 2/3"
echo " ════════════════════════════════════════"
echo ""
echo "  เพื่อยืนยันว่าเข้าใจว่าข้อมูลจะถูกลบถาวร"
echo "  กรุณาพิมพ์ข้อความต่อไปนี้ให้ตรงทุกตัวอักษร:"
echo ""
echo "    DELETE ALL PATIENT DATA"
echo ""
printf "  พิมพ์ข้อความยืนยัน: "
read -r CONFIRM2
if [ "$CONFIRM2" != "DELETE ALL PATIENT DATA" ]; then
  echo ""
  echo "  ข้อความไม่ตรง ยกเลิกการดำเนินการ ไม่มีข้อมูลถูกลบ"
  echo ""
  exit 0
fi

# ---- ขั้นตอนที่ 3: นับถอยหลัง ----
echo ""
echo " ════════════════════════════════════════"
echo "  ขั้นตอนการยืนยัน 3/3 — นับถอยหลัง"
echo " ════════════════════════════════════════"
echo ""
echo "  กำลังจะลบข้อมูลทั้งหมด..."
echo "  กด Ctrl+C ภายใน 10 วินาทีเพื่อยกเลิก"
echo ""

i=10
while [ "$i" -ge 1 ]; do
  echo "  ${i}..."
  sleep 1
  i=$((i - 1))
done

echo ""
echo "  เริ่มลบข้อมูล..."
echo ""

# ---- หยุด containers ก่อน ----
echo "[STEP 1/5] หยุด containers..."
docker compose down 2>/dev/null || true
echo ""

# ---- ลบ Docker volumes ----
echo "[STEP 2/5] ลบ Docker volumes..."
docker volume rm seamlessfordmis_postgres_data 2>/dev/null && echo "        ลบ postgres_data สำเร็จ" || echo "        [!] ไม่พบ volume postgres_data (อาจถูกลบแล้ว)"
docker volume rm seamlessfordmis_source_data   2>/dev/null && echo "        ลบ source_data สำเร็จ"   || echo "        [!] ไม่พบ volume source_data"
docker volume rm seamlessfordmis_uploads       2>/dev/null && echo "        ลบ uploads สำเร็จ"       || echo "        [!] ไม่พบ volume uploads"
docker volume rm seamlessfordmis_reports       2>/dev/null && echo "        ลบ reports สำเร็จ"       || echo "        [!] ไม่พบ volume reports"
docker volume rm seamlessfordmis_logs          2>/dev/null && echo "        ลบ logs สำเร็จ"          || echo "        [!] ไม่พบ volume logs"
echo ""

# ---- ลบ data/backups/ ----
echo "[STEP 3/5] ลบข้อมูลสำรองใน data/backups/..."
if [ -d "data/backups" ]; then
  rm -rf "data/backups"
  if [ ! -d "data/backups" ]; then
    echo "        ลบ data/backups/ สำเร็จ"
  else
    echo "        [!] ไม่สามารถลบ data/backups/ ได้ทั้งหมด อาจมีไฟล์ถูกล็อก"
  fi
else
  echo "        [!] ไม่พบโฟลเดอร์ data/backups/ (อาจถูกลบแล้ว)"
fi
echo ""

# ---- ลบ .env ----
echo "[STEP 4/5] ลบ .env..."
if [ -f ".env" ]; then
  rm -f ".env" && echo "        ลบ .env สำเร็จ" || echo "        [!] ไม่สามารถลบ .env ได้"
else
  echo "        [!] ไม่พบ .env"
fi
echo ""

# ---- สรุป ----
echo "[STEP 5/5] สรุปผล..."
echo ""
echo " ════════════════════════════════════════════════════"
echo "  การลบข้อมูลเสร็จสิ้น"
echo " ════════════════════════════════════════════════════"
echo ""
echo "  Docker volumes ที่เหลืออยู่:"
if docker volume ls --filter name=seamlessfordmis 2>/dev/null | grep -q seamlessfordmis; then
  echo "    [!] ยังมี volume บางอัน — ตรวจสอบด้วย: docker volume ls"
else
  echo "    ไม่มี seamlessfordmis volumes เหลืออยู่"
fi
echo ""
echo "  หากต้องการติดตั้งระบบใหม่:"
echo "    1. รัน offline/install.sh"
echo ""
